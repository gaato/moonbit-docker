{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "Asia/Tokyo",
  "schedule": [
    "before 9am on monday"
  ],
  "customManagers": [
    {
      "description": "Base images used by the build workflows",
      "customType": "regex",
      "managerFilePatterns": [
        "/^bases\\.json$/"
      ],
      "matchStrings": [
        "\"image\":\\s*\"(?<depName>[^\":]+):(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "docker"
    },
    {
      "description": "Runner labels that the github-actions manager misses: matrix values and expressions",
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/[^/]+\\.ya?ml$/"
      ],
      "matchStrings": [
        "(?:runner: |')(?<depName>ubuntu)-(?<currentValue>\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "github-runners"
    }
  ],
  "packageRules": [
    {
      "description": "Keep the Dockerfile default and every base on the same Node major",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "node"
      ],
      "groupName": "node base images"
    },
    {
      "description": "Move every runner label in one pull request",
      "matchDatasources": [
        "github-runners"
      ],
      "groupName": "GitHub runners"
    }
  ]
}
